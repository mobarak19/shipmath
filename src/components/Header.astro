---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import { SECTIONS, toolsIn, type Section } from '../data/tools';
import { u } from '../lib/url';
const path = Astro.url.pathname;
const menus: Section[] = ['ios'];
---
<header class="site-header">
  <div class="container">
    <a class="logo" href={u('/')} aria-label={`${SITE.name} home`}>
      <span class="logo-mark"><Icon name="calculator" size={20} /></span>
      {SITE.name}
    </a>
    <nav class="nav" aria-label="Main">
      {menus.map((s) => (
        <details class="nav-tools" data-nav-tools>
          <summary class="nav-keep">App Store tools <Icon name="chevronDown" size={16} /></summary>
          <div class="nav-menu">
            {toolsIn(s).map((t) => (
              <a href={u(`/${t.slug}/`)} aria-current={path.startsWith(u(`/${t.slug}/`)) ? 'page' : undefined}>
                <Icon name={t.icon} size={20} />
                <span><strong>{t.name}</strong><span>{t.card}</span></span>
              </a>
            ))}
          </div>
        </details>
      ))}
      <a href={SITE.sister.url} target="_blank" rel="noopener" title={SITE.sister.text}>AI cost tools ↗</a>
      <a href={u('/guides/')} aria-current={path.startsWith(u('/guides/')) ? 'page' : undefined}>Guides</a>
    </nav>
  </div>
</header>
