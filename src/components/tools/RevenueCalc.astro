<div class="calc" data-calc="revenue">
  <form>
    <div class="row2">
      <div class="field"><label for="dl">Downloads per month</label><input class="input" id="dl" name="dl" type="number" min="0" step="100" value="10000" /></div>
      <div class="field"><label for="cv">Download → paying <span class="hint">%</span></label><input class="input" id="cv" name="cv" type="number" min="0" max="100" step="0.1" value="2" /></div>
    </div>
    <div class="row2">
      <div class="field"><label for="pr">Price per purchase <span class="hint">USD</span></label><input class="input" id="pr" name="pr" type="number" min="0" step="0.01" value="9.99" /></div>
      <div class="field"><label for="pp">Purchases per payer / month</label><input class="input" id="pp" name="pp" type="number" min="0" step="0.1" value="1" /></div>
    </div>
    <div class="row3">
      <div class="field"><label for="cm">Commission %</label><input class="input" id="cm" name="cm" type="number" min="0" max="100" step="1" value="15" /></div>
      <div class="field"><label for="vat">Avg. VAT %</label><input class="input" id="vat" name="vat" type="number" min="0" max="30" step="0.5" value="8" /></div>
      <div class="field"><label for="rf">Refunds %</label><input class="input" id="rf" name="rf" type="number" min="0" max="100" step="0.5" value="2" /></div>
    </div>
    <p class="note">Average VAT: ~0% for US-only audiences, ~20% for Europe-heavy ones. Blend it to match your users.</p>
    <div class="share-row"><button type="button" class="btn btn-sm" data-action="copy-link">Copy link to this result</button><button type="button" class="btn btn-sm btn-ghost" data-action="reset">Reset</button></div>
  </form>
  <div class="out" data-out aria-live="polite"></div>
</div>
<script>
  import { mountCalc, num } from '../../app/calc';
  const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
  // Sub-dollar unit economics need a third decimal ($0.469, not $0.47).
  const fine = (x: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: Math.abs(x) < 1 ? 3 : 2, maximumFractionDigits: Math.abs(x) < 1 ? 3 : 2 }).format(x);
  mountCalc(document.querySelector<HTMLElement>('[data-calc="revenue"]')!, (v) => {
    const payers = num(v.dl) * (num(v.cv) / 100);
    const gross = payers * num(v.pr) * num(v.pp);
    const net = gross / (1 + num(v.vat) / 100);
    const commission = net * (num(v.cm) / 100);
    const refunds = (net - commission) * (num(v.rf) / 100);
    const proceeds = net - commission - refunds;
    return `<div class="big"><div class="k">Monthly proceeds</div><div class="v">${usd.format(proceeds)}</div><div class="s">${usd.format(proceeds * 12)} per year · ${Math.round(payers).toLocaleString()} paying users / month</div></div>
      <table class="kv">
        <tr><th>Gross sales</th><td>${usd.format(gross)}</td></tr>
        <tr><th>VAT removed</th><td>−${usd.format(gross - net)}</td></tr>
        <tr><th>Store commission</th><td>−${usd.format(commission)}</td></tr>
        <tr><th>Refunds</th><td>−${usd.format(refunds)}</td></tr>
        <tr><th><strong>Proceeds / month</strong></th><td><strong>${usd.format(proceeds)}</strong></td></tr>
        <tr><th>Revenue per download</th><td>${fine(num(v.dl) ? proceeds / num(v.dl) : 0)}</td></tr>
      </table>
      <p class="note">Revenue per download is a useful ceiling for what you can spend per install on ads (before considering lifetime value).</p>`;
  });
</script>
