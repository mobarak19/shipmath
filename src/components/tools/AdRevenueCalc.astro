---
import { AD_FORMATS } from '../../data/appstore';
---
<div class="calc" data-calc="ads">
  <form>
    <div class="row2">
      <div class="field"><label for="ad-dau">Daily active users</label><input class="input" id="ad-dau" name="dau" type="number" min="0" step="100" value="10000" /></div>
      <div class="field"><label for="ad-fill">Fill rate %</label><input class="input" id="ad-fill" name="fill" type="number" min="0" max="100" step="1" value="90" /></div>
    </div>
    {AD_FORMATS.map((f) => (
      <div class="row2">
        <div class="field"><label for={`${f.id}-imp`}>{f.name} <span class="hint">impressions / user / day</span></label><input class="input" id={`${f.id}-imp`} name={`${f.id}i`} type="number" min="0" step="0.5" value={f.imp} /></div>
        <div class="field"><label for={`${f.id}-ecpm`}>{f.name} eCPM ($)</label><input class="input" id={`${f.id}-ecpm`} name={`${f.id}e`} type="number" min="0" step="0.1" value={f.ecpm} /></div>
      </div>
    ))}
    <details class="group">
      <summary>Compare with a subscription <span class="count">optional</span></summary>
      <div style="padding:14px;display:grid;gap:12px">
        <div class="row2">
          <div class="field"><label for="ad-sp">Monthly subscription price</label><input class="input" id="ad-sp" name="sp" type="number" min="0" step="0.01" value="4.99" /></div>
          <div class="field"><label for="ad-cm">Commission %</label><input class="input" id="ad-cm" name="cm" type="number" min="0" max="100" step="1" value="15" /></div>
        </div>
      </div>
    </details>
    <p class="note">eCPM defaults are rough starting points. Use the real values from your AdMob (or other network) dashboard; they vary a lot by country.</p>
    <div class="share-row">
      <button type="button" class="btn btn-sm" data-action="copy-link">Copy link to this result</button>
      <button type="button" class="btn btn-sm btn-ghost" data-action="reset">Reset</button>
    </div>
  </form>
  <div class="out" data-out aria-live="polite"></div>
</div>

<script>
  import { mountCalc, num } from '../../app/calc';
  import { AD_FORMATS } from '../../data/appstore';

  const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
  const fine = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 4 });
  const DAYS_PER_MONTH = 365 / 12;

  mountCalc(document.querySelector<HTMLElement>('[data-calc="ads"]')!, (v) => {
    const dau = Math.max(0, num(v.dau));
    const fill = Math.min(100, Math.max(0, num(v.fill))) / 100;
    const formats = AD_FORMATS.map((f) => {
      const daily = dau * num(v[`${f.id}i`]) * fill * (num(v[`${f.id}e`]) / 1000);
      return { name: f.name, daily, monthly: daily * DAYS_PER_MONTH };
    });
    const daily = formats.reduce((a, f) => a + f.daily, 0);
    const monthly = daily * DAYS_PER_MONTH;
    const subNet = num(v.sp) * (1 - num(v.cm) / 100);
    const subs = subNet > 0 ? monthly / subNet : 0;
    const cls = ['c1', 'c2', 'c4'];
    return `<div class="big"><div class="k">Ad revenue per month</div><div class="v">${usd.format(monthly)}</div>
        <div class="s">${usd.format(monthly * 12)} per year · ARPDAU ${fine.format(dau ? daily / dau : 0)}</div>
        <div class="bar-split" aria-hidden="true">${formats.map((f, i) => `<i class="${cls[i]}" style="width:${monthly ? (f.monthly / monthly) * 100 : 0}%"></i>`).join('')}</div>
        <div class="legend">${formats.map((f, i) => `<span><b class="${cls[i]}"></b>${f.name} ${monthly ? Math.round((f.monthly / monthly) * 100) : 0}%</span>`).join('')}</div></div>
      <table class="kv">
        ${formats.map((f) => `<tr><th>${f.name}</th><td>${usd.format(f.monthly)}</td></tr>`).join('')}
        <tr><th>Per day</th><td>${usd.format(daily)}</td></tr>
      </table>
      <table class="kv">
        <tr><th>Subscribers that earn the same</th><td>${Math.ceil(subs).toLocaleString()}</td></tr>
        <tr><th>…as a share of daily users</th><td>${dau ? ((subs / dau) * 100).toFixed(2) : '0'}%</td></tr>
      </table>
      <p class="note">Ad revenue isn’t subject to App Store commission; the network’s reported eCPM is already your share.</p>`;
  });
</script>
