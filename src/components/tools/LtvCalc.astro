<div class="calc" data-calc="ltv">
  <form>
    <div class="row2">
      <div class="field"><label for="arpu">Monthly proceeds per subscriber <span class="hint">USD, after fees</span></label><input class="input" id="arpu" name="arpu" type="number" min="0" step="0.01" value="6.5" /></div>
      <div class="field"><label for="churn">Monthly churn %</label><input class="input" id="churn" name="churn" type="number" min="0.1" max="100" step="0.1" value="8" /></div>
    </div>
    <div class="field"><label for="margin">Gross margin % <span class="hint">after server/AI costs</span></label><input class="input" id="margin" name="margin" type="number" min="0" max="100" step="1" value="90" /></div>
    <div class="row2">
      <div class="field"><label for="cpi">Cost per install <span class="hint">USD, paid ads</span></label><input class="input" id="cpi" name="cpi" type="number" min="0" step="0.01" value="2" /></div>
      <div class="field"><label for="conv">Install → paying %</label><input class="input" id="conv" name="conv" type="number" min="0.1" max="100" step="0.1" value="4" /></div>
    </div>
    <div class="share-row"><button type="button" class="btn btn-sm" data-action="copy-link">Copy link to this result</button><button type="button" class="btn btn-sm btn-ghost" data-action="reset">Reset</button></div>
  </form>
  <div class="out" data-out aria-live="polite"></div>
</div>
<script>
  import { mountCalc, num } from '../../app/calc';
  import { ltv } from '../../lib/appmath';
  const usd = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
  // Sub-dollar unit economics need a third decimal ($0.469, not $0.47).
  const fine = (x: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', minimumFractionDigits: Math.abs(x) < 1 ? 3 : 2, maximumFractionDigits: Math.abs(x) < 1 ? 3 : 2 }).format(x);
  mountCalc(document.querySelector<HTMLElement>('[data-calc="ltv"]')!, (v) => {
    const r = ltv(num(v.arpu), num(v.churn), num(v.margin));
    const cac = num(v.conv) > 0 ? num(v.cpi) / (num(v.conv) / 100) : Infinity;
    const ratio = r.ltv / cac;
    const monthlyMargin = num(v.arpu) * (num(v.margin) / 100);
    const payback = monthlyMargin > 0 ? cac / monthlyMargin : Infinity;
    const verdict = ratio >= 3 ? ['alert-ok', 'Healthy: LTV is at least 3× acquisition cost.'] : ratio >= 1 ? ['alert-warn', 'Profitable but thin: aim for LTV:CAC ≥ 3 to fund growth.'] : ['alert-high', 'Losing money on each paid subscriber at these numbers.'];
    return `<div class="big"><div class="k">Lifetime value (LTV)</div><div class="v">${usd.format(r.ltv)}</div><div class="s">Average lifetime ≈ ${r.lifetimeMonths.toFixed(1)} months</div></div>
      <table class="kv">
        <tr><th>Cost per paying subscriber (CAC)</th><td>${usd.format(cac)}</td></tr>
        <tr><th>LTV : CAC</th><td>${Number.isFinite(ratio) ? ratio.toFixed(2) + '×' : '–'}</td></tr>
        <tr><th>CAC payback</th><td>${Number.isFinite(payback) ? payback.toFixed(1) + ' months' : '–'}</td></tr>
        <tr><th>Max affordable cost per install (LTV:CAC = 3)</th><td>${fine((r.ltv / 3) * (num(v.conv) / 100))}</td></tr>
      </table>
      <div class="alert ${verdict[0]}" style="margin:0"><div><p>${verdict[1]}</p></div></div>`;
  });
</script>
