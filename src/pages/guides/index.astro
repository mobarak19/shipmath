---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { u } from '../../lib/url';
const guides = [
  { href: '/guides/web-checkout-vs-in-app-purchase/', title: 'Web checkout vs in-app purchase after the 2025 US ruling', text: 'What changed for US apps, the fee maths and the conversion break-even.', icon: 'link' },
  { href: '/guides/app-store-fees-explained/', title: 'App Store fees explained: commission, VAT and proceeds', text: 'Why a €9.99 sale doesn’t pay €8.49, and how 15% vs 30% really works.', icon: 'dollar' },
];
---
<Base title="Guides for iOS App Developers" description="Plain-English guides to App Store fees, VAT, proceeds and web checkout vs in-app purchase.">
  <section class="hero container" style="text-align:left">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href={u('/')}>Home</a> / <span aria-current="page">Guides</span></nav>
    <h1 style="margin-left:0">Guides</h1>
  </section>
  <div class="container"><div class="tool-grid">
    {guides.map((g) => (<a class="tool-card" href={u(g.href)}><span class="ti"><Icon name={g.icon} size={22} /></span><span><strong>{g.title}</strong><span>{g.text}</span></span></a>))}
  </div></div>
</Base>
